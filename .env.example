# DeepSeek API Key (Required for script generation)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Podcast Feed Hosting Base URL (where RSS & audio files will be hosted)
PODCAST_BASE_URL=https://monurium.github.io/daily-podcast-generator

# Optional: Email Delivery Credentials (to receive daily MP3 + script in your inbox)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_TO=your_email@gmail.com

# Podcast Show Information
PODCAST_TITLE="Daily English B2 News Podcast"
PODCAST_AUTHOR="Monurium"
PODCAST_EMAIL="podcast@example.com"
