# OpenAI / LLM API Key (for script generation if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Podcast Feed Hosting Base URL (where RSS & audio files will be hosted, e.g. GitHub Pages or S3/CloudFront)
PODCAST_BASE_URL=https://monurium.github.io/daily-podcast-generator

# Podcast Metadata Overrides
PODCAST_TITLE="Daily Tech & AI Digest"
PODCAST_AUTHOR="Monurium"
PODCAST_EMAIL="podcast@example.com"
